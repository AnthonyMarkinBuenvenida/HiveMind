# Server-side only. Never prefix secrets with VITE_ — Vite would inline them into the browser bundle.
# Locally these go in .env; on Vercel set them as Environment Variables (Project → Settings).

# --- NVIDIA NIM (required) ---
NVIDIA_API_KEY=nvapi-your-key-here
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# Model selected for new visitors. The Vercel demo uses nvidia/nemotron-3-super-120b-a12b because
# NVIDIA queues DeepSeek for minutes when called from cloud IPs (see docs/API.md).
DEFAULT_MODEL=deepseek-ai/deepseek-v4.1-flash

# --- Rate limits (the demo's abuse protection; there is no sign-in) ---
# With a database URL, limits are global across all Vercel instances; without one they are per process.
# On Vercel, connecting a Neon (Postgres) resource sets DATABASE_URL automatically.
# DATABASE_URL=postgres://...
RATE_LIMIT_CHAT_PER_MIN=6
RATE_LIMIT_CHAT_PER_DAY=120
RATE_LIMIT_GLOBAL_PER_DAY=1500
MAX_CONCURRENT_STREAMS=2

# --- Output and timing ---
# App cap on output tokens; each model is further limited to what NVIDIA accepts (server/models.mjs).
MAX_OUTPUT_TOKENS=50000
# How long NVIDIA may queue a request before it starts (capped below the stream limit).
UPSTREAM_QUEUE_TIMEOUT_SECONDS=120
# Optional override for the per-response stream limit. Default: 10 min locally;
# on Vercel, FUNCTION_MAX_DURATION (300, must match vercel.json) minus 15 s.
# STREAM_LIMIT_SECONDS=600

# --- Logging ---
# One line per /api request: method, path, status, duration, hashed client id. No bodies or IPs.
LOG_REQUESTS=true
# Salt for the hashed client id in logs (random per process if unset).
# LOG_SALT=
